// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Expense model for tracking spending
model Expense {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  title     String
  amount    Float
  date      DateTime
  note      String?
  account   String   @default("default") // Account/wallet identifier
  categoryId String? @db.ObjectId
  category   Category? @relation("ExpenseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime?
}

// Income model for tracking earnings
model Income {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  title     String
  amount    Float
  date      DateTime
  note      String?
  account   String   @default("default") // Account/wallet identifier
  categoryId String? @db.ObjectId
  category   Category? @relation("IncomeCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime?
}

model Category {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  name      String
  type      String   @default("expense") // "income" or "expense"
  createdAt DateTime @default(now())

  expenses  Expense[] @relation("ExpenseCategory")
  incomes   Income[]  @relation("IncomeCategory")
}
